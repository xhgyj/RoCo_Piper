<?xml version="1.0"?>
<!--
  Top-level execution model for the container-side Piper_L MoveIt stack.

  Mirrors the pinned vendor composition pattern in
  isaac/vendor/agx_arm_sim/Moveit2/piper_l_gripper_moveit_config/config/piper_l.gazebo.urdf.xacro:
  it includes the pinned agx_arm_description piper_l gripper xacro unchanged and
  attaches the ros2_control block that talks to the host Isaac bridge.

  Position limits stay at the pinned agx_arm_urdf values (wide joint4/joint5);
  the execution-limit narrowing for joint4/joint5 is planning-side only and
  lives in config/joint_limits.yaml.

  R5.A addition: the zero-geometry project-calibrated TCP frame
  rocobrick_tcp (link6 -> rocobrick_tcp fixed joint) is appended from the
  generated urdf/piper_l.tcp_calibration.xacro overlay; the pinned vendor
  description itself stays untouched.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper_l">
  <xacro:arg
    name="initial_positions_file"
    default="$(find rocobrick_piper_l_moveit_config)/config/initial_positions.yaml"/>

  <!-- Pinned planning model (agx_arm_urdf submodule checkout, do not edit). -->
  <xacro:include
    filename="$(find agx_arm_description)/agx_arm_urdf/piper_l/urdf/piper_l_with_gripper_description.xacro"/>
  <xacro:include filename="$(find rocobrick_piper_l_moveit_config)/urdf/piper_l.ros2_control.xacro"/>
  <!-- Generated project TCP calibration overlay (single artifact authority). -->
  <xacro:include filename="$(find rocobrick_piper_l_moveit_config)/urdf/piper_l.tcp_calibration.xacro"/>
  <!-- Wrist camera overlay: d435 stand + camera collision bodies, copied
       verbatim from the runtime d435 description (see the overlay header). -->
  <xacro:include filename="$(find rocobrick_piper_l_moveit_config)/urdf/piper_l.camera_stand.xacro"/>

  <xacro:piper_l_ros2_control
    name="PiperLIsaacTopicBasedSystem"
    initial_positions_file="$(arg initial_positions_file)"/>
  <xacro:piper_l_tcp_calibration/>
  <xacro:piper_l_camera_stand/>
</robot>
